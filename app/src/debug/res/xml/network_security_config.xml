<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Lets the app talk to a meewind server running on the laptop over
  `adb reverse tcp:8137 tcp:8137`, so live sharing can be tried without deploying first.
  Release builds keep Android's default: HTTPS or nothing.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
